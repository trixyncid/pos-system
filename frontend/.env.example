# Empty for local dev (Vite proxies /api to http://127.0.0.1:8000) and for
# production, where Caddy serves the app and the API on one origin.
# Only set it to call an API elsewhere, e.g. https://api.example.com/api/v1
VITE_API_URL=

# true serves every API call from the MSW mocks in src/mocks (bun run dev:mock sets it).
VITE_USE_MOCKS=false
