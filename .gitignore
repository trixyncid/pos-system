# =============================================================================
# Monorepo .gitignore — backend (Django) + frontend (Vite/React)
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & environment
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
firebase-credentials.json
*firebase-adminsdk*.json
service-account*.json

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Editors / IDEs
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# Python / Django (backend)
# -----------------------------------------------------------------------------
# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
env/
venv/
.venv/
ENV/

# Packaging
build/
*.egg-info/
.eggs/
*.egg
wheels/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.dmypy.json
.pyre/
.tox/
.nox/

# Test coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Django
db.sqlite3
db.sqlite3-journal
*.sqlite3
backend/media/
backend/staticfiles/
backend/backups/
backend/secrets/
celerybeat-schedule
celerybeat.pid

# -----------------------------------------------------------------------------
# Node / Vite (frontend)
# -----------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/
coverage/
*.tsbuildinfo
.eslintcache
.vercel/

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
docker-compose.override.yml

# Frontend test output
playwright-report/
test-results/

# Playwright MCP scratch output
.playwright-mcp/
