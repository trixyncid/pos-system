# Production refuses to start with DEBUG=0 and no real key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Off unless set to 1. Keep it 0 in production.
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# The outlet's own clock: business days, shifts and reports follow it. Samarinda is WITA.
TIME_ZONE=Asia/Makassar
# Swagger UI at /api/v1/docs/ is public only with DEBUG=1 or this set to 1.
API_DOCS_PUBLIC=0

SQL_DATABASE=pos
SQL_USER=postgres
# Required by docker-compose.prod.yml. Use a long random value in production.
SQL_PASSWORD=password

# Set by docker compose. Leave empty for a single local process (in-memory cache and channels).
REDIS_URL=

# React origin allowed to call /api/ with the refresh cookie.
FRONTEND_URL=http://localhost:3000

# Public API hostname for Caddy, which also gets and renews its certificate.
DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Staff PIN lock: wrong attempts allowed, then minutes locked.
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15

# Optional. Leave empty to skip Sentry.
SENTRY_DSN=
